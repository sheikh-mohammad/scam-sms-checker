# Which AI provider the server calls: gemini | anthropic | groq
# Defaults to "gemini" if unset. Only the active provider's key is required.
AI_PROVIDER=gemini

# --- Google Gemini (free tier available) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Anthropic Claude (paid) ---
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Groq (free tier available, very fast) ---
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# WARNING: never put any of these keys in a NEXT_PUBLIC_ variable.
# Only NEXT_PUBLIC_ variables reach the browser, so keep the prefix off.
